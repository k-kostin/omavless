 //! Socket options as used by `setsockopt` and `getsockopt`.
+/// Linux network namespace cookie of a socket, distinct from `SO_COOKIE`.
+#[cfg(target_os = "linux")]
+#[derive(Clone, Copy, Debug)]
+pub struct NetnsCookie;
+
+#[cfg(target_os = "linux")]
+impl super::GetSockOpt for NetnsCookie {
+    type Val = u64;
+
+    fn get<F: std::os::fd::AsFd>(&self, fd: &F) -> crate::Result<u64> {
+        let mut value = 0_u64;
+        let mut length = std::mem::size_of::<u64>() as libc::socklen_t;
+        // SAFETY: fixed SOL_SOCKET/SO_NETNS_COOKIE writes only into a live,
+        // initialized aligned u64, with its actual capacity. The descriptor
+        // remains borrowed. Validate length before interpreting the result.
+        crate::errno::Errno::result(unsafe {
+            libc::getsockopt(
+                fd.as_fd().as_raw_fd(),
+                libc::SOL_SOCKET,
+                libc::SO_NETNS_COOKIE,
+                &mut value as *mut u64 as *mut libc::c_void,
+                &mut length,
+            )
+        })?;
+        netns_cookie_value(value, length)
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn netns_cookie_value(
+    value: u64,
+    length: libc::socklen_t,
+) -> crate::Result<u64> {
+    if length as usize != std::mem::size_of::<u64>() || value == 0 {
+        return Err(crate::errno::Errno::EINVAL);
+    }
+    Ok(value)
+}
+
+#[cfg(all(test, target_os = "linux"))]
+mod netns_cookie_tests {
+    use super::*;
+    use crate::sys::socket::GetSockOpt;
+
+    #[test]
+    fn malformed_length_and_zero_refuse_without_panicking() {
+        for length in [0, 1, 4, 7, 9, u32::MAX] {
+            assert_eq!(netns_cookie_value(1, length), Err(Errno::EINVAL));
+        }
+        assert_eq!(netns_cookie_value(0, 8), Err(Errno::EINVAL));
+        assert_eq!(netns_cookie_value(u64::MAX, 8), Ok(u64::MAX));
+    }
+
+    #[test]
+    fn regular_file_is_not_a_socket() {
+        let file = std::fs::File::open("/dev/null").unwrap();
+        assert_eq!(NetnsCookie.get(&file), Err(Errno::ENOTSOCK));
+    }
+
+    #[cfg(feature = "ioctl")]
+    #[test]
+    fn current_socket_cookie_matches_current_network_namespace_id() {
+        use std::os::fd::AsFd;
+        let ns = std::fs::File::open("/proc/thread-self/ns/net").unwrap();
+        let socket = std::net::UdpSocket::bind("127.0.0.1:0").unwrap();
+        match crate::sys::nsfs::namespace_id(ns.as_fd()) {
+            Ok(id) => assert_eq!(NetnsCookie.get(&socket), Ok(id)),
+            Err(error) => assert_eq!(error, Errno::ENOTTY),
+        }
+    }
+}
