+//! Fixed, read-only Linux namespace descriptor queries.
+//!
+//! Descriptor identity is not proof of a canonical host or trusted launch.
+use crate::{errno::Errno, Result};
+use std::os::fd::{AsRawFd, BorrowedFd};
+
+/// Kernel namespace kinds understood by this API.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum NamespaceType {
+    /// Network namespace.
+    Network,
+    /// User namespace.
+    User,
+    /// PID namespace.
+    Pid,
+    /// Mount namespace.
+    Mount,
+    /// UTS namespace.
+    Uts,
+    /// IPC namespace.
+    Ipc,
+    /// Cgroup namespace.
+    Cgroup,
+    /// Time namespace.
+    Time,
+}
+
+/// Query `NS_GET_NSTYPE` on a borrowed namespace descriptor.
+/// Unknown future types return `EOPNOTSUPP`; syscall errors are preserved.
+pub fn namespace_type(fd: BorrowedFd<'_>) -> Result<NamespaceType> {
+    // SAFETY: this fixed no-argument ioctl neither reads nor writes userspace
+    // memory. The live descriptor is borrowed for the complete call.
+    let value = Errno::result(unsafe {
+        libc::ioctl(fd.as_raw_fd(), libc::NS_GET_NSTYPE)
+    })?;
+    match value {
+        libc::CLONE_NEWNET => Ok(NamespaceType::Network),
+        libc::CLONE_NEWUSER => Ok(NamespaceType::User),
+        libc::CLONE_NEWPID => Ok(NamespaceType::Pid),
+        libc::CLONE_NEWNS => Ok(NamespaceType::Mount),
+        libc::CLONE_NEWUTS => Ok(NamespaceType::Uts),
+        libc::CLONE_NEWIPC => Ok(NamespaceType::Ipc),
+        libc::CLONE_NEWCGROUP => Ok(NamespaceType::Cgroup),
+        libc::CLONE_NEWTIME => Ok(NamespaceType::Time),
+        _ => Err(Errno::EOPNOTSUPP),
+    }
+}
+
+/// Query the 64-bit namespace identifier using `NS_GET_ID`.
+/// This never substitutes a procfs inode or a namespace-relative netlink ID.
+pub fn namespace_id(fd: BorrowedFd<'_>) -> Result<u64> {
+    let mut value = 0_u64;
+    // Linux UAPI _IOR(NSIO, 13, __u64), encoded with the target ABI macros.
+    let request =
+        crate::request_code_read!(0xb7, 13, std::mem::size_of::<u64>());
+    // SAFETY: only this fixed read ioctl is issued. The aligned, initialized
+    // u64 output remains live and exclusively borrowed throughout the call.
+    let result = Errno::result(unsafe {
+        libc::ioctl(fd.as_raw_fd(), request as _, &mut value as *mut u64)
+    })?;
+    if result != 0 || value == 0 {
+        return Err(Errno::EINVAL);
+    }
+    Ok(value)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{fs::File, os::fd::AsFd};
+
+    #[test]
+    fn ordinary_files_are_not_namespace_descriptors() {
+        let file = File::open("/dev/null").unwrap();
+        assert_eq!(namespace_type(file.as_fd()), Err(Errno::ENOTTY));
+        assert_eq!(namespace_id(file.as_fd()), Err(Errno::ENOTTY));
+    }
+
+    #[test]
+    fn current_network_and_pid_kinds_differ() {
+        let net = File::open("/proc/thread-self/ns/net").unwrap();
+        let pid = File::open("/proc/thread-self/ns/pid").unwrap();
+        assert_eq!(namespace_type(net.as_fd()), Ok(NamespaceType::Network));
+        assert_eq!(namespace_type(pid.as_fd()), Ok(NamespaceType::Pid));
+        // Old kernels are unsupported, not a fabricated identity.
+        match namespace_id(net.as_fd()) {
+            Ok(id) => assert_ne!(id, 0),
+            Err(error) => assert_eq!(error, Errno::ENOTTY),
+        }
+    }
+
+    #[test]
+    #[ignore = "explicit isolated development VM only"]
+    fn isolated_namespace_cookie_relationships() {
+        assert_eq!(
+            std::env::var("NIX_NAMESPACE_REVIEW_VM").as_deref(),
+            Ok("1")
+        );
+        let parent = File::open("/proc/thread-self/ns/net").unwrap();
+        let parent_id = namespace_id(parent.as_fd()).unwrap();
+        let own = std::env::current_exe().unwrap();
+        let status = std::process::Command::new("/usr/bin/unshare")
+            .args(["--user", "--map-root-user", "--net"])
+            .arg(own)
+            .args([
+                "--ignored",
+                "--exact",
+                "sys::nsfs::tests::isolated_namespace_worker",
+                "--test-threads=1",
+            ])
+            .env("NIX_NAMESPACE_REVIEW_WORKER", "1")
+            .status()
+            .unwrap();
+        assert!(status.success());
+        let current = File::open("/proc/thread-self/ns/net").unwrap();
+        assert_eq!(namespace_id(current.as_fd()), Ok(parent_id));
+        assert_eq!(namespace_id(parent.as_fd()), Ok(parent_id));
+    }
+
+    #[test]
+    #[ignore = "internal disposable namespace worker"]
+    fn isolated_namespace_worker() {
+        use crate::sys::socket::sockopt::NetnsCookie;
+        use crate::sys::socket::GetSockOpt;
+        use crate::sys::socket::{socket, AddressFamily, SockFlag, SockType};
+        assert_eq!(
+            std::env::var("NIX_NAMESPACE_REVIEW_VM").as_deref(),
+            Ok("1")
+        );
+        assert_eq!(
+            std::env::var("NIX_NAMESPACE_REVIEW_WORKER").as_deref(),
+            Ok("1")
+        );
+        // Both namespaces are disposable local fixtures, not canonical hosts.
+        let first = File::open("/proc/thread-self/ns/net").unwrap();
+        assert_eq!(namespace_type(first.as_fd()), Ok(NamespaceType::Network));
+        let first_id = namespace_id(first.as_fd()).unwrap();
+        let before = socket(
+            AddressFamily::Inet,
+            SockType::Datagram,
+            SockFlag::SOCK_CLOEXEC,
+            None,
+        )
+        .unwrap();
+        assert_eq!(NetnsCookie.get(&before), Ok(first_id));
+        crate::sched::unshare(crate::sched::CloneFlags::CLONE_NEWNET).unwrap();
+        let second = File::open("/proc/thread-self/ns/net").unwrap();
+        let second_id = namespace_id(second.as_fd()).unwrap();
+        assert_ne!(first_id, second_id);
+        assert_eq!(namespace_id(first.as_fd()), Ok(first_id));
+        assert_eq!(NetnsCookie.get(&before), Ok(first_id));
+        let after = socket(
+            AddressFamily::Inet,
+            SockType::Datagram,
+            SockFlag::SOCK_CLOEXEC,
+            None,
+        )
+        .unwrap();
+        assert_eq!(NetnsCookie.get(&after), Ok(second_id));
+        assert_ne!(NetnsCookie.get(&before).unwrap(), second_id);
+        let duplicate = first.try_clone().unwrap();
+        drop(first);
+        assert_eq!(namespace_id(duplicate.as_fd()), Ok(first_id));
+        assert_eq!(namespace_type(second.as_fd()), Ok(NamespaceType::Network));
+    }
+}
