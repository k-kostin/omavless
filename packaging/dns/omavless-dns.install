# Package lifecycle only. Enrollment and service activation require separate
# attended administrator actions; neither happens during pacman installation.
pre_upgrade() {
  /usr/lib/omavless-dns/package-guard
}

pre_remove() {
  /usr/lib/omavless-dns/package-guard
}

post_install() {
  /usr/bin/setcap cap_net_bind_service,cap_net_admin,cap_net_raw=ep /usr/lib/omavless-dns/mihomo || return 1
  printf '%s\n' 'OmaVLESS DNS package installed but NOT enrolled, enabled or started.'
}

post_upgrade() {
  post_install
}

# No automatic stop, enable, enrollment, DNS cleanup or journal removal.
