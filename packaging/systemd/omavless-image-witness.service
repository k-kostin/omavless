# Opt-in SOURCE candidate; package installation never enrolls/enables/starts it.
[Unit]
Description=OmaVLESS fixed current-executable observation provider
ConditionFileIsExecutable=/usr/lib/omavless-image/omavless-image-witness
ConditionPathExists=/var/lib/omavless-image-product/runtime.enrollment

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/lib/omavless-image/omavless-image-witness --product-epoch-service
Restart=no
RuntimeDirectory=omavless-image-product
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=CAP_SYS_PTRACE
NoNewPrivileges=yes
LimitNOFILE=64
LimitCORE=0
TasksMax=1
RestrictAddressFamilies=AF_UNIX
# Kernel peer/child identity must share the actual PID/user view; no fake PID1.
PrivateUsers=no
PrivateNetwork=no
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/omavless-image-product
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
