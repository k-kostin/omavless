[Unit]
Description=OmaVLESS canonical user runtime
Documentation=https://github.com/k-kostin/omavless
After=network-online.target
Requires=omavless-login-prepare.service
After=omavless-login-prepare.service
ConditionFileIsExecutable=/usr/bin/omavless

[Service]
Type=simple
ExecStart=/usr/bin/omavless daemon --product-image-witness
Restart=no
RestartSec=2s
RuntimeDirectory=omavless
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
# Arch file-capability host policy; see docs/roadmap/ARCH_SERVICE_SECURITY.md.
# The unprivileged runtime must let the separately provisioned core acquire
# its network capabilities in the host user namespace. Namespace/seccomp
# hardening that implies PrivateUsers or NoNewPrivileges is incompatible.
NoNewPrivileges=no
LimitCORE=0
ConfigurationDirectory=omavless
ConfigurationDirectoryMode=0700
StateDirectory=omavless
StateDirectoryMode=0700
CacheDirectory=omavless
CacheDirectoryMode=0700

[Install]
WantedBy=default.target
