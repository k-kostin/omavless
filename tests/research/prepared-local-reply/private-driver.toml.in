# REVIEW TEMPLATE ONLY: not named Cargo.toml and never applied or executed.
# Exact private68f driver relocated with an explicit external shim placeholder.
# Relocation is uncompiled and cannot inherit the original private build result.
# Private external test driver, NOT an ordinary runtime/product manifest.
[package]
name = "omavless-prepared-local-reply-source-experiment"
version = "0.0.0"
edition = "2024"
publish = false

[workspace]

[lib]
path = "../crates/omavless-runtime/src/lib.rs"

[features]
default = ["prepared-local-reply"]
prepared-local-reply = []
tui = ["dep:omavless-tui"]

[dependencies]
base64 = "0.22"
nix = { version = "0.30", features = ["fs", "process", "signal", "socket", "user"] }
omavless-control-protocol = { path = "../crates/omavless-control-protocol" }
omavless-domain = { path = "../crates/omavless-domain" }
omavless-mihomo = { path = "../crates/omavless-mihomo" }
omavless-profile = { path = "../crates/omavless-profile" }
omavless-store = { path = "../crates/omavless-store" }
omavless-tui = { path = "../crates/omavless-tui", optional = true }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
sha2 = "0.10"
signal-hook = "0.3"
ureq = { version = "3.4", default-features = false, features = ["platform-verifier", "rustls"] }
url = "2.5"
zeroize = "1.8"

[dev-dependencies]
rustix = { version = "=1.1.5", features = ["event", "fs", "net", "process"] }
tempfile = "=3.27.0"
prepared-rustix = { package = "rustix-owned-ancillary-local-harness", path = "@PREPARED_RUSTIX_0A0C958_HARNESS@", features = ["fs", "process"] }

[lints.rust]
unsafe_code = "forbid"
