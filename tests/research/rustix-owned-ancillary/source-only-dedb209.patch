+# Local Linux-only offline test harness, NOT an upstream/package manifest.
+# The untouched registry manifest/lock are retained in rustix-1.1.5/.
+[package]
+name = "rustix-owned-ancillary-local-harness"
+version = "0.0.0"
+edition = "2021"
+publish = false
+build = "build.rs"
+
+[workspace]
+
+[lib]
+name = "rustix"
+path = "../rustix-1.1.5/src/lib.rs"
+
+[features]
+default = ["std", "net", "event"]
+alloc = []
+std = ["alloc", "bitflags/std", "libc/std"]
+net = ["linux-raw-sys/net", "linux-raw-sys/netlink", "linux-raw-sys/if_ether", "linux-raw-sys/xdp"]
+use-libc = []
+event = []
+fs = []
+pipe = []
+stdio = []
+process = ["linux-raw-sys/prctl"]
+# Enables ONLY compilation of a default-ignored fresh no-child control.
+kernel-owned-control = ["fs", "pipe", "process", "stdio"]
+
+[dependencies]
+bitflags = { version = "=2.13.1", default-features = false }
+linux-raw-sys = { version = "=0.12.1", default-features = false, features = ["general", "ioctl", "errno", "no_std"] }
+libc = { version = "=0.2.190", default-features = false }
+libc_errno = { package = "errno", version = "=0.3.14", default-features = false }
+
+[dev-dependencies]
+memoffset = "=0.9.1"
+static_assertions = "=1.1.0"
+# Required by byte-unchanged upstream fs unit-test bodies at compile time only.
+tempfile = { version = "=3.27.0", default-features = false }
