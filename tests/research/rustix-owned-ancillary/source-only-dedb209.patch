diff --git a/rustix-1.1.5/src/net/send_recv/owned_ancillary_experiment.rs b/rustix-1.1.5/src/net/send_recv/owned_ancillary_experiment.rs
new file mode 100644
index 0000000..e7b3389
--- /dev/null
+++ b/rustix-1.1.5/src/net/send_recv/owned_ancillary_experiment.rs
@@ -0,0 +1,854 @@
+//! Review-only additive Linux owned ancillary receive experiment.
+//!
+//! Not an upstream patch or a product authority constructor. Unknown header
+//! kinds remain explicit; only kernel-provided SCM_RIGHTS and exact SCM_PIDFD
+//! successes are adopted. SCM_PIDFD negative errno results own no descriptor. An
+//! invalid header boundary stops parsing without speculative resynchronization.
+//! This cannot claim ownership of descriptor-bearing unknown ABI kinds.
+
+use super::*;
+use crate::fd::FromRawFd;
+use alloc::vec::Vec;
+
+// Pinned Linux v6.17 include/linux/socket.h: SCM_PIDFD is a separate ONE-int
+// receive ABI. Neither pinned libc nor linux_raw_sys reexports its constant.
+// Do not confuse SO_PASSPIDFD (76) with this ancillary kind (4).
+const SCM_PIDFD_KNOWN_ABI: i32 = 0x04;
+
+#[cfg(all(
+    test,
+    feature = "std",
+    feature = "fs",
+    feature = "pipe",
+    feature = "process"
+))]
+#[path = "owned_ancillary_kernel_control.rs"]
+mod kernel_control;
+
+#[cfg(all(
+    test,
+    feature = "std",
+    feature = "event",
+    feature = "fs",
+    feature = "pipe",
+    feature = "process",
+    target_arch = "x86_64"
+))]
+#[path = "owned_ancillary_pidfd_kernel_control.rs"]
+mod pidfd_kernel_control;
+
+/// Finite structural failure, retained alongside previously decoded rights.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[non_exhaustive]
+pub enum AncillaryBoundaryError {
+    /// Fewer bytes than a complete native header remained.
+    ShortHeader,
+    /// The declared header length was shorter than the payload offset.
+    ShortLength,
+    /// The declared message extended beyond the kernel's returned buffer.
+    BeyondBuffer,
+    /// Checked offset or alignment arithmetic overflowed.
+    Overflow,
+}
+
+/// Credentials represented without constructing a possibly invalid NonZero PID.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct ReceivedCredentials {
+    /// Kernel-provided raw PID; the protocol must validate its exact owner.
+    pub pid: i32,
+    /// Kernel-provided raw UID.
+    pub uid: u32,
+    /// Kernel-provided raw GID.
+    pub gid: u32,
+}
+
+/// One ordered record per header, without silently dropping unknown shapes.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[non_exhaustive]
+pub enum OwnedAncillaryRecord {
+    /// Rights in `[first,end)` of the frame's owned rights collection.
+    Rights {
+        /// First owned descriptor index.
+        first: usize,
+        /// Exclusive last owned descriptor index.
+        end: usize,
+        /// Exact header payload size.
+        payload_bytes: usize,
+        /// True only for an exact descriptor multiple with no negative slot.
+        exact_shape: bool,
+    },
+    /// Credentials of exactly the native ABI size.
+    Credentials(ReceivedCredentials),
+    /// A credential header whose exact size is not the native ABI size.
+    MalformedCredentials {
+        /// Exact received payload size, not private payload bytes.
+        payload_bytes: usize,
+    },
+    /// One exact kernel-installed PIDFD, borrowed through `pidfds()[index]`.
+    /// This descriptor is a kernel PID reference, not authenticated root origin.
+    PidFd {
+        /// Index in the frame's separate owned PIDFD collection.
+        index: usize,
+    },
+    /// Exact negative Linux errno payload; the kernel installed no PIDFD.
+    /// This is data in a completed frame, not a failed receive/dropped frame.
+    PidFdError(io::Errno),
+    /// Nonexact PIDFD length or out-of-range negative scalar; never guess an FD.
+    /// Ownership of corrupt/invalid kernel PIDFD payloads remains unproven.
+    MalformedPidFd {
+        /// Exact received payload size, not raw payload bytes.
+        payload_bytes: usize,
+    },
+    /// An unknown header, including its exact shape but not raw payload bytes.
+    Unknown {
+        /// Kernel header level.
+        level: i32,
+        /// Kernel header kind.
+        kind: i32,
+        /// Exact received payload size.
+        payload_bytes: usize,
+    },
+}
+
+/// Completed receive with safely decoded known rights and PIDFDs still owned.
+///
+/// Semantic refusal is data in this result, never an error that discards known
+/// originals. The protocol owner must retain the whole result before any late
+/// or malformed-frame refusal. Normal Drop closes known rights once. Unknown
+/// descriptor-bearing ABI kinds are not interpreted and remain an explicit gap.
+pub struct OwnedRecvMsg {
+    message: RecvMsg,
+    records: Vec<OwnedAncillaryRecord>,
+    rights: Vec<OwnedFd>,
+    pidfds: Vec<OwnedFd>,
+    boundary: Option<AncillaryBoundaryError>,
+    // Preserve bytes (including uninitialized padding) without reading/exporting
+    // them. They are NOT a second OwnedFd owner or raw-fd authority interface.
+    _control: Vec<MaybeUninit<u8>>,
+}
+
+impl OwnedRecvMsg {
+    /// The actual kernel receive result, including TRUNC/CTRUNC and address.
+    pub fn message(&self) -> &RecvMsg {
+        &self.message
+    }
+    /// Ordered header records; unknown and malformed known shapes stay visible.
+    pub fn records(&self) -> &[OwnedAncillaryRecord] {
+        &self.records
+    }
+    /// Borrow all safely decoded SCM_RIGHTS originals without duplication.
+    pub fn rights(&self) -> &[OwnedFd] {
+        &self.rights
+    }
+    /// Borrow exact successful SCM_PIDFD originals, never opened from a PID.
+    /// Negative error records and malformed/unknown headers add no descriptor.
+    pub fn pidfds(&self) -> &[OwnedFd] {
+        &self.pidfds
+    }
+    /// A structural parse boundary failure, not authentication or authority.
+    pub fn boundary_error(&self) -> Option<AncillaryBoundaryError> {
+        self.boundary
+    }
+}
+
+/// Receive once and bind actual kernel flags/control bytes to one owned result.
+///
+/// The old receive/drain API is unchanged. This Linux-only experiment requires
+/// the same trusted-backend valid kernel-owned descriptor invariant as the old
+/// safe drain. A fresh internal receive context cannot contain partially drained
+/// legacy messages. It does not make invalid raw ancillary injection safe.
+pub fn recvmsg_owned<Fd: AsFd>(
+    socket: Fd,
+    iov: &mut [IoSliceMut<'_>],
+    buffer: &mut [MaybeUninit<u8>],
+    flags: RecvFlags,
+) -> io::Result<OwnedRecvMsg> {
+    let mut control = RecvAncillaryBuffer::new(buffer);
+    let message = super::recvmsg(socket, iov, &mut control, flags)?;
+    Ok(take_control(message, &mut control))
+}
+
+fn take_control(message: RecvMsg, control: &mut RecvAncillaryBuffer<'_>) -> OwnedRecvMsg {
+    let mut result = OwnedRecvMsg {
+        message,
+        records: Vec::new(),
+        rights: Vec::new(),
+        pidfds: Vec::new(),
+        boundary: None,
+        _control: Vec::new(),
+    };
+    let Some(end) = control.read.checked_add(control.length) else {
+        result.boundary = Some(AncillaryBoundaryError::Overflow);
+        // This cannot occur through the trusted backend. Do not fabricate a
+        // recoverable ownership claim or run the legacy parser on corruption.
+        control.length = 0;
+        control.read = 0;
+        return result;
+    };
+    let Some(raw) = control.buffer.get(control.read..end) else {
+        result.boundary = Some(AncillaryBoundaryError::BeyondBuffer);
+        control.length = 0;
+        control.read = 0;
+        return result;
+    };
+    result._control.extend_from_slice(raw);
+    // Ownership is consumed once before interpretation. Legacy Drop must not
+    // adopt/close the same raw rights a second time, including on refusal.
+    control.length = 0;
+    control.read = 0;
+    let length = result._control.len();
+    let header = unsafe { c::CMSG_LEN(0) } as usize;
+    let align = align_of::<c::cmsghdr>();
+    let mut offset = 0_usize;
+    while offset < length {
+        if length - offset < size_of::<c::cmsghdr>() {
+            result.boundary = Some(AncillaryBoundaryError::ShortHeader);
+            break;
+        }
+        // SAFETY: These header bytes were initialized by the trusted recvmsg
+        // backend. read_unaligned does not assume Vec<u8> header alignment.
+        let msg = unsafe {
+            result
+                ._control
+                .as_ptr()
+                .add(offset)
+                .cast::<c::cmsghdr>()
+                .read_unaligned()
+        };
+        let size = msg.cmsg_len as usize;
+        if size < header {
+            result.boundary = Some(AncillaryBoundaryError::ShortLength);
+            break;
+        }
+        let Some(last) = offset.checked_add(size) else {
+            result.boundary = Some(AncillaryBoundaryError::Overflow);
+            break;
+        };
+        if last > length {
+            result.boundary = Some(AncillaryBoundaryError::BeyondBuffer);
+            break;
+        }
+        let payload = offset + header;
+        let payload_bytes = size - header;
+        match (msg.cmsg_level as _, msg.cmsg_type as _) {
+            (c::SOL_SOCKET, c::SCM_RIGHTS) => {
+                let first = result.rights.len();
+                let unit = size_of::<c::c_int>();
+                let mut exact_shape = payload_bytes % unit == 0;
+                for index in 0..payload_bytes / unit {
+                    // SAFETY: Only complete native SCM_RIGHTS slots from a
+                    // successful trusted kernel receive are adopted. No public
+                    // raw parser, guessed unknown kind or duplicate FD exists.
+                    let fd = unsafe {
+                        result
+                            ._control
+                            .as_ptr()
+                            .add(payload + index * unit)
+                            .cast::<c::c_int>()
+                            .read_unaligned()
+                    };
+                    if fd < 0 {
+                        exact_shape = false;
+                        continue;
+                    }
+                    result.rights.push(unsafe { OwnedFd::from_raw_fd(fd) });
+                }
+                result.records.push(OwnedAncillaryRecord::Rights {
+                    first,
+                    end: result.rights.len(),
+                    payload_bytes,
+                    exact_shape,
+                });
+            }
+            (c::SOL_SOCKET, c::SCM_CREDENTIALS) => {
+                if payload_bytes == size_of::<ReceivedCredentials>() {
+                    // SAFETY: Exact-length initialized payload; all scalar bit
+                    // patterns are valid. No unchecked NonZeroPid construction.
+                    let value = unsafe {
+                        result
+                            ._control
+                            .as_ptr()
+                            .add(payload)
+                            .cast::<ReceivedCredentials>()
+                            .read_unaligned()
+                    };
+                    result
+                        .records
+                        .push(OwnedAncillaryRecord::Credentials(value));
+                } else {
+                    result
+                        .records
+                        .push(OwnedAncillaryRecord::MalformedCredentials { payload_bytes });
+                }
+            }
+            (level, kind) if level == c::SOL_SOCKET && kind as i32 == SCM_PIDFD_KNOWN_ABI => {
+                if payload_bytes != size_of::<c::c_int>() {
+                    // Linux's producer checks room for the complete int before
+                    // reserving/installing any PIDFD. Corrupt backend/injection
+                    // is outside that contract: no prefix or unknown-FD guess.
+                    result
+                        .records
+                        .push(OwnedAncillaryRecord::MalformedPidFd { payload_bytes });
+                } else {
+                    // SAFETY: Exact-length initialized native int from the same
+                    // trusted successful kernel receive, not public raw input.
+                    let value = unsafe {
+                        result
+                            ._control
+                            .as_ptr()
+                            .add(payload)
+                            .cast::<c::c_int>()
+                            .read_unaligned()
+                    };
+                    if value >= 0 {
+                        let index = result.pidfds.len();
+                        // SAFETY: Pinned scm_pidfd_recv installs this exact
+                        // nonnegative scalar only after successful put_cmsg.
+                        // Kernel pidfd_prepare reserves it CLOEXEC, independent
+                        // of MSG_CMSG_CLOEXEC. This library is its sole adopter.
+                        result.pidfds.push(unsafe { OwnedFd::from_raw_fd(value) });
+                        result.records.push(OwnedAncillaryRecord::PidFd { index });
+                    } else if (-4095..0).contains(&value) {
+                        // Validate Linux errno range before negating/constructing
+                        // Errno: raw backend asserts that range; MIN must not
+                        // overflow or silently alias a valid error.
+                        result.records.push(OwnedAncillaryRecord::PidFdError(
+                            io::Errno::from_raw_os_error(-value),
+                        ));
+                    } else {
+                        result
+                            .records
+                            .push(OwnedAncillaryRecord::MalformedPidFd { payload_bytes });
+                    }
+                }
+            }
+            _ => result.records.push(OwnedAncillaryRecord::Unknown {
+                level: msg.cmsg_level as _,
+                kind: msg.cmsg_type as _,
+                payload_bytes,
+            }),
+        }
+        let Some(aligned) = last.checked_add(align - 1) else {
+            result.boundary = Some(AncillaryBoundaryError::Overflow);
+            break;
+        };
+        // Final padding need not be present; never read its uninitialized bytes.
+        offset = (aligned & !(align - 1)).min(length);
+    }
+    result
+}
