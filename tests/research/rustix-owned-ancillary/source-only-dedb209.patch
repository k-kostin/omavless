+//! Default-ignored, fixed own no-child kernel control proposal.
+//!
+//! Three separately owned unnamed pairs, one send/receive each. No wait/retry,
+//! fork/spawn, pathname, primary process change, VM or ancestor/root authority.
+//! No application RawFd adoption. ROOT source review and separate authorization
+//! are required before selecting this ignored control. OOM/backend partial-
+//! error ownership remains the separately documented library limitation.
+
+use super::*;
+use crate::fs::fstat;
+use crate::io::{fcntl_getfd, read, write, FdFlags};
+use crate::net::{socketpair, sockopt, AddressFamily, SocketFlags, SocketType};
+use crate::pipe::{pipe_with, PipeFlags};
+use crate::process::{getegid, geteuid, getgid, getpid, getuid};
+use core::mem::ManuallyDrop;
+use core::ops::{Deref, DerefMut};
+use std::time::{Duration, Instant};
+
+// Successful acquired kernel-owner graphs survive any subsequent assertion or
+// late-return refusal, until this dedicated test process exits. There is no
+// close/drop/retry method. This is not a production resource-lifetime policy.
+struct Retained<T>(ManuallyDrop<T>);
+impl<T> Retained<T> {
+    fn new(value: T) -> Self {
+        Self(ManuallyDrop::new(value))
+    }
+}
+impl<T> Deref for Retained<T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        &self.0
+    }
+}
+impl<T> DerefMut for Retained<T> {
+    fn deref_mut(&mut self) -> &mut T {
+        &mut self.0
+    }
+}
+
+fn gate(end: Instant) {
+    assert!(Instant::now() < end, "fixed_known_abi_deadline_refused");
+}
+
+// Structurally forbid kernel-owner results here: those use explicit immediate
+// pre-reserved retention before their post-call gate below.
+fn checked<T: Copy>(end: Instant, operation: impl FnOnce() -> io::Result<T>) -> T {
+    gate(end);
+    let value = operation().unwrap_or_else(|_| panic!("fixed_known_abi_operation_refused"));
+    gate(end);
+    value
+}
+
+#[test]
+#[ignore = "Requires separately reviewed exact source and ROOT authorization; never a failed-child retry"]
+fn fresh_no_child_known_abi_receive_once() {
+    let end = Instant::now()
+        .checked_add(Duration::from_secs(8))
+        .expect("fixed_deadline_overflow");
+    // Reserve bounded vectors BEFORE any acquisition. Successful kernel owners
+    // are pushed without new allocation BEFORE every post-acquisition gate.
+    let mut sockets = Retained::new(Vec::with_capacity(3));
+    let mut pipes = Retained::new(Vec::with_capacity(9));
+    let mut frames = Retained::new(Vec::with_capacity(3));
+    gate(end);
+    let pid = getpid().as_raw_pid();
+    gate(end);
+    let uid = getuid().as_raw();
+    gate(end);
+    let gid = getgid().as_raw();
+    gate(end);
+    let euid = geteuid().as_raw();
+    gate(end);
+    let egid = getegid().as_raw();
+    gate(end);
+    assert!(
+        pid > 1 && uid != 0 && gid != 0 && uid == euid && gid == egid,
+        "fixed_unprivileged_current_owner_refused"
+    );
+    let expected_credentials = ReceivedCredentials { pid, uid, gid };
+    let payload = b"FIXED_KNOWN_ANCILLARY_V1";
+
+    // Fixed cases: complete receive, control truncation, payload truncation.
+    // Any unknown/failure panics with a fixed literal and aborts later cases.
+    for case in 0..3 {
+        gate(end);
+        assert!(
+            sockets.len() < sockets.capacity(),
+            "fixed_socket_capacity_refused"
+        );
+        let pair = socketpair(
+            AddressFamily::UNIX,
+            SocketType::SEQPACKET,
+            SocketFlags::CLOEXEC | SocketFlags::NONBLOCK,
+            None,
+        )
+        .unwrap_or_else(|_| panic!("fixed_socketpair_refused"));
+        sockets.push(pair);
+        gate(end);
+        let (sender, receiver) = &sockets[case];
+        checked(end, || sockopt::set_socket_passcred(receiver, true));
+        assert!(
+            checked(end, || sockopt::socket_passcred(receiver)),
+            "fixed_passcred_refused"
+        );
+        for _ in 0..3 {
+            gate(end);
+            assert!(
+                pipes.len() < pipes.capacity(),
+                "fixed_pipe_capacity_refused"
+            );
+            let pair = pipe_with(PipeFlags::CLOEXEC | PipeFlags::NONBLOCK)
+                .unwrap_or_else(|_| panic!("fixed_pipe_refused"));
+            pipes.push(pair);
+            gate(end);
+        }
+        let base = case * 3;
+        let originals = [
+            pipes[base].0.as_fd(),
+            pipes[base + 1].0.as_fd(),
+            pipes[base + 2].0.as_fd(),
+        ];
+        let mut outgoing_space = [MaybeUninit::uninit(); crate::cmsg_space!(ScmRights(3))];
+        let mut outgoing = SendAncillaryBuffer::new(&mut outgoing_space);
+        assert!(
+            outgoing.push(SendAncillaryMessage::ScmRights(&originals)),
+            "fixed_send_shape_refused"
+        );
+        let sent = checked(end, || {
+            super::super::sendmsg(
+                sender,
+                &[IoSlice::new(payload)],
+                &mut outgoing,
+                SendFlags::DONTWAIT | SendFlags::NOSIGNAL,
+            )
+        });
+        assert!(sent == payload.len(), "fixed_send_count_refused");
+        let mut data = [0_u8; 64];
+        let data_len = if case == 2 { 8 } else { data.len() };
+        let mut incoming =
+            [MaybeUninit::uninit(); crate::cmsg_space!(ScmRights(3), ScmCredentials(1))];
+        let control_len = if case == 1 {
+            crate::cmsg_space!(ScmCredentials(1))
+        } else {
+            incoming.len()
+        };
+        let flags = RecvFlags::DONTWAIT
+            | RecvFlags::CMSG_CLOEXEC
+            | if case == 2 {
+                RecvFlags::TRUNC
+            } else {
+                RecvFlags::empty()
+            };
+        gate(end);
+        assert!(
+            frames.len() < frames.capacity(),
+            "fixed_frame_capacity_refused"
+        );
+        let frame = recvmsg_owned(
+            receiver,
+            &mut [IoSliceMut::new(&mut data[..data_len])],
+            &mut incoming[..control_len],
+            flags,
+        )
+        .unwrap_or_else(|_| panic!("fixed_receive_refused"));
+        frames.push(frame);
+        gate(end);
+        let frame = &frames[case];
+        assert!(
+            frame.boundary_error().is_none(),
+            "fixed_header_boundary_refused"
+        );
+        assert!(
+            frame.message().bytes == payload.len(),
+            "fixed_receive_count_refused"
+        );
+        assert!(
+            data[..data_len.min(payload.len())] == payload[..data_len.min(payload.len())],
+            "fixed_received_payload_refused"
+        );
+        assert!(
+            frame.message().flags.contains(ReturnFlags::CTRUNC) == (case == 1),
+            "fixed_control_truncation_refused"
+        );
+        assert!(
+            frame.message().flags.contains(ReturnFlags::TRUNC) == (case == 2),
+            "fixed_payload_truncation_refused"
+        );
+        // Address is only structural metadata of this original unnamed pair;
+        // no address absence, creator credentials or root-auth claim is made.
+        let expected_rights = if case == 1 { 0 } else { 3 };
+        assert!(
+            frame.rights().len() == expected_rights,
+            "fixed_rights_count_refused"
+        );
+        assert!(
+            frame.records().first()
+                == Some(&OwnedAncillaryRecord::Credentials(expected_credentials)),
+            "fixed_current_credentials_refused"
+        );
+        if case == 1 {
+            assert!(
+                frame.records().len() == 1,
+                "fixed_truncated_record_shape_refused"
+            );
+        } else {
+            assert!(
+                frame.records()
+                    == [
+                        OwnedAncillaryRecord::Credentials(expected_credentials),
+                        OwnedAncillaryRecord::Rights {
+                            first: 0,
+                            end: 3,
+                            payload_bytes: 12,
+                            exact_shape: true
+                        },
+                    ],
+                "fixed_complete_record_shape_refused"
+            );
+        }
+        for (index, received) in frame.rights().iter().enumerate() {
+            let before = checked(end, || fstat(&pipes[base + index].0));
+            let actual = checked(end, || fstat(received));
+            assert!(
+                before.st_dev == actual.st_dev
+                    && before.st_ino == actual.st_ino
+                    && before.st_mode == actual.st_mode,
+                "fixed_pipe_original_metadata_refused"
+            );
+            let flags = checked(end, || fcntl_getfd(received));
+            assert!(
+                flags.contains(FdFlags::CLOEXEC),
+                "fixed_received_cloexec_refused"
+            );
+            let sent = checked(end, || write(&pipes[base + index].1, &[0x31 + index as u8]));
+            assert!(sent == 1, "fixed_pipe_byte_count_refused");
+            let mut byte = [0_u8];
+            let count = checked(end, || read(received, &mut byte));
+            assert!(
+                count == 1 && byte[0] == 0x31 + index as u8,
+                "fixed_pipe_original_alias_refused"
+            );
+        }
+        gate(end);
+    }
+    assert!(
+        sockets.len() == 3 && pipes.len() == 9 && frames.len() == 3,
+        "fixed_final_owner_count_refused"
+    );
+    gate(end);
+    // No success-close. Entire retained graph dies only with this test process.
+}
diff --git a/rustix-1.1.5/src/net/send_recv/owned_ancillary_pidfd_kernel_control.rs b/rustix-1.1.5/src/net/send_recv/owned_ancillary_pidfd_kernel_control.rs
