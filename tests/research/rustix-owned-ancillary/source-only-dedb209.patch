index 0000000..88deb0e
--- /dev/null
+++ b/rustix-1.1.5/src/net/send_recv/owned_ancillary_pidfd_kernel_control.rs
@@ -0,0 +1,288 @@
+//! Default-ignored own no-child PIDFD receive proposal. No actual selection.
+//! Only ROOT after FULL source/recipe reviews may select this exact control.
+//! No PID reconstruction, application unsafe/RawFd adoption, signal or child.
+//! Poll checks are empirical behavior, NOT unique class/identity proof.
+
+use super::*;
+use crate::event::{poll, PollFd, PollFlags, Timespec};
+use crate::fs::fstat;
+use crate::io::{fcntl_getfd, read, write, FdFlags};
+use crate::net::{socketpair, sockopt, AddressFamily, SocketFlags, SocketType};
+use crate::pipe::{pipe_with, PipeFlags};
+use crate::process::{getegid, geteuid, getgid, getpid, getuid};
+use core::mem::ManuallyDrop;
+use core::ops::{Deref, DerefMut};
+use std::time::{Duration, Instant};
+
+struct Retained<T>(ManuallyDrop<T>);
+impl<T> Retained<T> {
+    fn new(value: T) -> Self {
+        Self(ManuallyDrop::new(value))
+    }
+}
+impl<T> Deref for Retained<T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        &self.0
+    }
+}
+impl<T> DerefMut for Retained<T> {
+    fn deref_mut(&mut self) -> &mut T {
+        &mut self.0
+    }
+}
+
+fn gate(end: Instant) {
+    assert!(Instant::now() < end, "fixed_pidfd_deadline_refused");
+}
+
+// Kernel-owner results cannot enter this helper and die at its post-call gate.
+fn checked<T: Copy>(end: Instant, operation: impl FnOnce() -> io::Result<T>) -> T {
+    gate(end);
+    let value = operation().unwrap_or_else(|_| panic!("fixed_pidfd_operation_refused"));
+    gate(end);
+    value
+}
+
+fn options(end: Instant, sender: &OwnedFd, receiver: &OwnedFd, enabled: bool) {
+    let sender_pidfd = checked(end, || {
+        backend::net::sockopt::passpidfd_owned_control(sender.as_fd())
+    });
+    let receiver_pidfd = checked(end, || {
+        backend::net::sockopt::passpidfd_owned_control(receiver.as_fd())
+    });
+    assert!(
+        !sender_pidfd && receiver_pidfd == enabled,
+        "fixed_pidfd_options_refused"
+    );
+}
+
+#[test]
+#[ignore = "Requires separately reviewed exact source and ROOT authorization; no old control retry"]
+fn fresh_no_child_pidfd_receive_once() {
+    let end = Instant::now()
+        .checked_add(Duration::from_secs(8))
+        .expect("fixed_pidfd_deadline_overflow");
+    // Reserve before acquisitions. Whole graphs enter retention BEFORE every
+    // post-call fence; no success/failure Drop, close, query or retry follows.
+    let mut sockets = Retained::new(Vec::with_capacity(3));
+    let mut pipes = Retained::new(Vec::with_capacity(1));
+    let mut frames = Retained::new(Vec::with_capacity(3));
+    gate(end);
+    let pid = getpid().as_raw_pid();
+    gate(end);
+    let uid = getuid().as_raw();
+    gate(end);
+    let gid = getgid().as_raw();
+    gate(end);
+    let euid = geteuid().as_raw();
+    gate(end);
+    let egid = getegid().as_raw();
+    gate(end);
+    assert!(
+        pid > 1 && uid != 0 && gid != 0 && uid == euid && gid == egid,
+        "fixed_pidfd_unprivileged_owner_refused"
+    );
+    let credentials = ReceivedCredentials { pid, uid, gid };
+    let payload = b"FIXED_OWN_PIDFD_V1";
+
+    // Case0: PIDFD only, no MSG_CMSG_CLOEXEC. Case1: credentials, one original
+    // pipe right, PIDFD with MSG_CMSG_CLOEXEC. Case2: credential-only capacity
+    // omits PIDFD under actual CTRUNC. All three pairs are newly owned.
+    for case in 0..3 {
+        gate(end);
+        assert!(
+            sockets.len() < sockets.capacity(),
+            "fixed_pidfd_socket_capacity_refused"
+        );
+        let pair = socketpair(
+            AddressFamily::UNIX,
+            SocketType::SEQPACKET,
+            SocketFlags::CLOEXEC | SocketFlags::NONBLOCK,
+            None,
+        )
+        .unwrap_or_else(|_| panic!("fixed_pidfd_socketpair_refused"));
+        sockets.push(pair);
+        gate(end);
+        let (sender, receiver) = &sockets[case];
+        options(end, sender, receiver, false);
+        assert!(
+            !checked(end, || sockopt::socket_passcred(sender))
+                && !checked(end, || sockopt::socket_passcred(receiver)),
+            "fixed_pidfd_initial_passcred_refused"
+        );
+        if case != 0 {
+            checked(end, || sockopt::set_socket_passcred(receiver, true));
+        }
+        checked(end, || {
+            backend::net::sockopt::set_passpidfd_owned_control(receiver.as_fd())
+        });
+        options(end, sender, receiver, true);
+        let mut outgoing_space = [MaybeUninit::uninit(); crate::cmsg_space!(ScmRights(1))];
+        let mut outgoing = SendAncillaryBuffer::new(&mut outgoing_space);
+        if case == 1 {
+            gate(end);
+            assert!(
+                pipes.len() < pipes.capacity(),
+                "fixed_pidfd_pipe_capacity_refused"
+            );
+            let pipe = pipe_with(PipeFlags::CLOEXEC | PipeFlags::NONBLOCK)
+                .unwrap_or_else(|_| panic!("fixed_pidfd_pipe_refused"));
+            pipes.push(pipe);
+            gate(end);
+        }
+        let originals = if case == 1 {
+            Some([pipes[0].0.as_fd()])
+        } else {
+            None
+        };
+        if let Some(originals) = &originals {
+            assert!(
+                outgoing.push(SendAncillaryMessage::ScmRights(originals)),
+                "fixed_pidfd_send_shape_refused"
+            );
+        }
+        options(end, sender, receiver, true);
+        assert!(
+            !checked(end, || sockopt::socket_passcred(sender))
+                && checked(end, || sockopt::socket_passcred(receiver)) == (case != 0),
+            "fixed_pidfd_send_options_refused"
+        );
+        let sent = checked(end, || {
+            super::super::sendmsg(
+                sender,
+                &[IoSlice::new(payload)],
+                &mut outgoing,
+                SendFlags::DONTWAIT | SendFlags::NOSIGNAL,
+            )
+        });
+        assert!(sent == payload.len(), "fixed_pidfd_send_count_refused");
+        let mut data = [0_u8; 32];
+        // PIDFD has the same one-native-int length/alignment as one right;
+        // this storage macro does not reclassify or send a PIDFD as RIGHTS.
+        let mut incoming = [MaybeUninit::uninit();
+            crate::cmsg_space!(ScmCredentials(1), ScmRights(1), ScmRights(1))];
+        let control_len = if case == 2 {
+            crate::cmsg_space!(ScmCredentials(1))
+        } else {
+            incoming.len()
+        };
+        options(end, sender, receiver, true);
+        assert!(
+            checked(end, || sockopt::socket_passcred(receiver)) == (case != 0),
+            "fixed_pidfd_receive_options_refused"
+        );
+        gate(end);
+        assert!(
+            frames.len() < frames.capacity(),
+            "fixed_pidfd_frame_capacity_refused"
+        );
+        let frame = recvmsg_owned(
+            receiver,
+            &mut [IoSliceMut::new(&mut data)],
+            &mut incoming[..control_len],
+            RecvFlags::DONTWAIT
+                | if case == 1 {
+                    RecvFlags::CMSG_CLOEXEC
+                } else {
+                    RecvFlags::empty()
+                },
+        )
+        .unwrap_or_else(|_| panic!("fixed_pidfd_receive_refused"));
+        frames.push(frame);
+        gate(end);
+        let frame = &frames[case];
+        assert!(
+            frame.boundary_error().is_none(),
+            "fixed_pidfd_header_boundary_refused"
+        );
+        assert!(
+            frame.message().bytes == payload.len() && data[..payload.len()] == payload[..],
+            "fixed_pidfd_payload_refused"
+        );
+        assert!(
+            frame.message().flags.contains(ReturnFlags::CTRUNC) == (case == 2)
+                && !frame.message().flags.contains(ReturnFlags::TRUNC),
+            "fixed_pidfd_flags_refused"
+        );
+        match case {
+            0 => assert!(
+                frame.records() == [OwnedAncillaryRecord::PidFd { index: 0 }],
+                "fixed_pidfd_only_shape_refused"
+            ),
+            1 => assert!(
+                frame.records()
+                    == [
+                        OwnedAncillaryRecord::Credentials(credentials),
+                        OwnedAncillaryRecord::Rights {
+                            first: 0,
+                            end: 1,
+                            payload_bytes: 4,
+                            exact_shape: true
+                        },
+                        OwnedAncillaryRecord::PidFd { index: 0 }
+                    ],
+                "fixed_pidfd_combined_shape_refused"
+            ),
+            2 => assert!(
+                frame.records() == [OwnedAncillaryRecord::Credentials(credentials)],
+                "fixed_pidfd_truncated_shape_refused"
+            ),
+            _ => unreachable!(),
+        }
+        assert!(
+            frame.pidfds().len() == if case == 2 { 0 } else { 1 }
+                && frame.rights().len() == if case == 1 { 1 } else { 0 },
+            "fixed_pidfd_owner_counts_refused"
+        );
+        // Borrow only the installed original held by the ENTIRE retained frame.
+        // No pidfd_open/getfd/namespace ioctl, proc path, PID serialization or
+        // second FD owner. A zero timeout is one poll call, never a wait loop.
+        for original in frame.pidfds() {
+            assert!(
+                checked(end, || fcntl_getfd(original)).contains(FdFlags::CLOEXEC),
+                "fixed_pidfd_cloexec_refused"
+            );
+            let mut entries = [PollFd::new(original, PollFlags::IN)];
+            let zero = Timespec {
+                tv_sec: 0,
+                tv_nsec: 0,
+            };
+            assert!(
+                checked(end, || poll(&mut entries, Some(&zero))) == 0
+                    && entries[0].revents().is_empty(),
+                "fixed_pidfd_poll_refused"
+            );
+        }
+        if case == 1 {
+            let original = &pipes[0].0;
+            let received = &frame.rights()[0];
+            let a = checked(end, || fstat(original));
+            let b = checked(end, || fstat(received));
+            assert!(
+                a.st_dev == b.st_dev && a.st_ino == b.st_ino && a.st_mode == b.st_mode,
+                "fixed_pidfd_pipe_identity_refused"
+            );
+            assert!(
+                checked(end, || fcntl_getfd(received)).contains(FdFlags::CLOEXEC),
+                "fixed_pidfd_right_cloexec_refused"
+            );
+            assert!(
+                checked(end, || write(&pipes[0].1, &[0x35])) == 1,
+                "fixed_pidfd_pipe_write_refused"
+            );
+            let mut byte = [0_u8; 1];
+            assert!(
+                checked(end, || read(received, &mut byte)) == 1 && byte == [0x35],
+                "fixed_pidfd_pipe_alias_refused"
+            );
+        }
+        gate(end);
+    }
+    assert!(
+        sockets.len() == 3 && pipes.len() == 1 && frames.len() == 3,
+        "fixed_pidfd_final_graph_refused"
+    );
+    gate(end);
+    // No close/drop/cleanup even on success. Dedicated process exit ends graph.
+}
