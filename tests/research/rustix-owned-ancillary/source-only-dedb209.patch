+        let mut control = RecvAncillaryBuffer::new(&mut storage);
+        control.buffer[..bytes.len()].copy_from_slice(bytes);
+        // Private synthetic fixtures deliberately exercise structural refusal;
+        // this is not a public raw-parser or a kernel-ownership claim.
+        control.length = bytes.len();
+        let frame = take_control(
+            RecvMsg {
+                bytes: 7,
+                flags,
+                address: None,
+            },
+            &mut control,
+        );
+        assert_eq!(control.read, 0);
+        assert_eq!(control.length, 0);
+        assert_eq!(control.drain().count(), 0);
+        drop(control);
+        frame
+    }
