+// Review-only harness: run the BYTE-UNCHANGED upstream build script from its
+// original source directory so its relative inline-assembly detection is exact.
+mod upstream {
+    include!("../rustix-1.1.5/build.rs");
+    pub fn run() {
+        main();
+    }
+}
+
+fn main() {
+    let original = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../rustix-1.1.5");
+    std::env::set_current_dir(original).unwrap();
+    upstream::run();
+}
