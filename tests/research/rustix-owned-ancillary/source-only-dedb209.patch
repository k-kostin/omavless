+    fn append(bytes: &mut Vec<MaybeUninit<u8>>, level: i32, kind: i32, payload: &[u8]) {
+        let header = unsafe { c::CMSG_LEN(0) } as usize;
+        let length = header + payload.len();
+        let start = bytes.len();
+        let space = unsafe { c::CMSG_SPACE(payload.len() as _) } as usize;
+        bytes.resize(start + space, MaybeUninit::new(0));
+        // The test initializes every header field and the payload. Keeping
+        // padding as MaybeUninit avoids reading native struct padding as u8.
+        unsafe {
+            let raw = bytes.as_mut_ptr().add(start).cast::<c::cmsghdr>();
+            ptr::addr_of_mut!((*raw).cmsg_len).write_unaligned(length as _);
+            ptr::addr_of_mut!((*raw).cmsg_level).write_unaligned(level as _);
+            ptr::addr_of_mut!((*raw).cmsg_type).write_unaligned(kind as _);
+            ptr::copy_nonoverlapping(
+                payload.as_ptr(),
+                bytes.as_mut_ptr().add(start + header).cast(),
+                payload.len(),
+            );
+        }
+    }
