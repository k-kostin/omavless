+// Additive private experiment: unlike recvmsg, snapshot scalar outputs even on
+// Err. No address copyout, no legacy ancillary length/Drop, no error decoding.
+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+pub(crate) fn recvmsg_retained_snapshot(
+    sockfd: BorrowedFd<'_>,
+    iov: &mut [IoSliceMut<'_>],
+    control: &mut [MaybeUninit<u8>],
+    flags: RecvFlags,
+) -> (io::Result<usize>, usize, ReturnFlags) {
+    let mut header = super::msghdr::zero_msghdr();
+    header.msg_iov = iov.as_mut_ptr().cast();
+    header.msg_iovlen = iov.len() as _;
+    header.msg_control = control.as_mut_ptr().cast();
+    header.msg_controllen = control.len() as _;
+    // SAFETY: private caller supplies a live exclusive aligned control slice
+    // and live exclusive iov buffers for this sole synchronous syscall. Scalar
+    // snapshots are initialized fields; on Err they are NOT a valid prefix.
+    let result = unsafe {
+        ret_usize(syscall!(__NR_recvmsg, sockfd, by_mut(&mut header), flags))
+    };
+    (result, header.msg_controllen as usize,
+        ReturnFlags::from_bits_retain(header.msg_flags))
+}
