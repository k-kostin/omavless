+// Linux/x64-only additive private experiment, never the ordinary recvmsg path.
+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+fn terminal_header_count<T: TryFrom<usize>>(count: usize) -> Option<T> {
+    T::try_from(count).ok()
+}
+
+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+pub(crate) fn recvmsg_retained_snapshot(
+    sockfd: BorrowedFd<'_>,
+    iov: &mut [IoSliceMut<'_>],
+    control: &mut [MaybeUninit<u8>],
+    flags: RecvFlags,
+) -> (io::Result<usize>, usize, ReturnFlags) {
+    let mut header = super::msghdr::zero_msghdr();
+    header.msg_iov = iov.as_mut_ptr().cast();
+    // GNU uses size_t, while musl uses c_int. Refuse unrepresentable input
+    // before syscall entry instead of silently narrowing or truncating it.
+    header.msg_iovlen = match terminal_header_count(iov.len()) {
+        Some(count) => count,
+        None => return (Err(io::Errno::INVAL), 0, ReturnFlags::empty()),
+    };
+    header.msg_control = control.as_mut_ptr().cast();
+    header.msg_controllen = match terminal_header_count(control.len()) {
+        Some(count) => count,
+        None => return (Err(io::Errno::INVAL), 0, ReturnFlags::empty()),
+    };
+    // SAFETY: same live exclusive memory/one-call contract as the raw backend.
+    // No address copyout; scalar fields are opaque snapshots on Err, not a
+    // promise that header.msg_controllen bytes form installed owning records.
+    let result = unsafe {
+        ret_send_recv(c::recvmsg(borrowed_fd(sockfd), &mut header,
+            bitflags_bits!(flags)))
+    };
+    (result, header.msg_controllen as usize,
+        ReturnFlags::from_bits_retain(bitcast!(header.msg_flags)))
+}
+
+#[cfg(all(test, target_os = "linux", target_arch = "x86_64"))]
+#[test]
+fn terminal_header_count_refuses_narrowing_without_syscall() {
+    assert_eq!(terminal_header_count::<i32>(0), Some(0));
+    assert_eq!(terminal_header_count::<i32>(i32::MAX as usize), Some(i32::MAX));
+    assert_eq!(terminal_header_count::<i32>(i32::MAX as usize + 1), None);
+    assert_eq!(terminal_header_count::<i32>(usize::MAX), None);
+    assert_eq!(terminal_header_count::<usize>(usize::MAX), Some(usize::MAX));
+}
