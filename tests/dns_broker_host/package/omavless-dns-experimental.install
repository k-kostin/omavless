# Package lifecycle only, never called by ordinary application IPC.
pre_upgrade() {
  /usr/lib/omavless-dns-experimental/package-guard
}

pre_remove() {
  /usr/lib/omavless-dns-experimental/package-guard
}

post_install() {
  /usr/bin/setcap cap_net_bind_service,cap_net_admin,cap_net_raw=ep /usr/lib/omavless-dns-experimental/mihomo || return 1
  printf '%s\n' 'Experimental DNS components installed but NOT enrolled, enabled or started.'
}

post_upgrade() {
  post_install
}

# Deliberately no stop, enable, enrollment, DNS cleanup or journal removal hooks.
