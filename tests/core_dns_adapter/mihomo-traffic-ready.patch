new file mode 100644
--- /dev/null
+++ b/hub/route/traffic_ready.go
@@ -0,0 +1,21 @@
+package route
+
+import (
+	"github.com/metacubex/chi/render"
+	"github.com/metacubex/http"
+	"github.com/metacubex/mihomo/tunnel"
+)
+
+// This is only the core's current external-traffic admission state. It is
+// neither a connectivity verdict nor conditional-close authorization.
+func trafficReady(w http.ResponseWriter, r *http.Request) {
+	if r.URL.RawQuery != "" || r.URL.ForceQuery || r.ContentLength != 0 ||
+		len(r.TransferEncoding) != 0 || (r.Body != nil && r.Body != http.NoBody) {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	render.JSON(w, r, struct {
+		ABI   uint8 `json:"abi"`
+		Ready bool  `json:"ready"`
+	}{1, tunnel.Status() == tunnel.Running})
+}
diff --git a/hub/route/traffic_ready_test.go b/hub/route/traffic_ready_test.go
