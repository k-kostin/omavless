diff --git i/config/system_dns_test.go w/config/system_dns_test.go
new file mode 100644
index 0000000..6f92b2f
--- /dev/null
+++ w/config/system_dns_test.go
@@ -0,0 +1,52 @@
+package config
+
+import (
+	"encoding/json"
+	"testing"
+
+	"go.yaml.in/yaml/v3"
+)
+
+func TestSystemDNSOption(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		input string
+		want  bool
+	}{
+		{"omitted", "{}", false},
+		{"false", "disable-system-dns: false", false},
+		{"true", "disable-system-dns: true", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var raw RawTun
+			if err := yaml.Unmarshal([]byte(tc.input), &raw); err != nil {
+				t.Fatal(err)
+			}
+			raw.DNSHijack = []string{"any:53"}
+			raw.AutoRoute = true
+			raw.FileDescriptor = 42
+			var general General
+			if err := parseTun(raw, &DNS{}, &general); err != nil {
+				t.Fatal(err)
+			}
+			if general.Tun.DisableSystemDNS != tc.want {
+				t.Fatal("DNS ownership flag lost")
+			}
+			if !general.Tun.AutoRoute || general.Tun.FileDescriptor != 42 ||
+				len(general.Tun.DNSHijack) != 1 || general.Tun.DNSHijack[0] != "any:53" {
+				t.Fatal("unrelated TUN configuration changed")
+			}
+			encoded, err := json.Marshal(general.Tun)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var fields map[string]any
+			if err := json.Unmarshal(encoded, &fields); err != nil {
+				t.Fatal(err)
+			}
+			if fields["disable-system-dns"] != tc.want {
+				t.Fatal("controller projection lost flag")
+			}
+		})
+	}
+}
diff --git i/listener/config/system_dns_test.go w/listener/config/system_dns_test.go
new file mode 100644
index 0000000..840684a
--- /dev/null
+++ w/listener/config/system_dns_test.go
@@ -0,0 +1,14 @@
+package config
+
+import "testing"
+
+func TestSystemDNSOwnershipChangeRequiresTunReplacement(t *testing.T) {
+	legacy := Tun{}
+	external := Tun{DisableSystemDNS: true}
+	if !legacy.Equal(legacy) || !external.Equal(external) {
+		t.Fatal("same policy must compare equal")
+	}
+	if legacy.Equal(external) || external.Equal(legacy) {
+		t.Fatal("changed DNS writer retained old TUN")
+	}
+}
