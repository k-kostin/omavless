new file mode 100644
--- /dev/null
+++ b/listener/sing_tun/system_dns_device_test.go
@@ -0,0 +1,23 @@
+package sing_tun
+
+import (
+	LC "github.com/metacubex/mihomo/listener/config"
+	"net/netip"
+	"testing"
+)
+
+func TestSystemDNSDeviceFlavorExclusive(t *testing.T) {
+	for _, name := range []string{"Meta", "omavless0", "", "other", "MetaX", "omavless00"} {
+		candidate := LC.Tun{OmaVLESSDNSBroker: true, DisableSystemDNS: true,
+			Device: name, Inet4Address: []netip.Prefix{netip.MustParsePrefix("198.18.0.1/30")}}
+		if fixedDNSBrokerTunPolicy(candidate) != (name == systemDNSDevice) {
+			t.Fatal("device flavor policy mismatch")
+		}
+		if name != systemDNSDevice {
+			listener, err := New(candidate, nil)
+			if listener != nil || err == nil || err.Error() != "OmaVLESS DNS broker policy is unavailable" {
+				t.Fatal("cross-flavor device was not refused before effects")
+			}
+		}
+	}
+}
