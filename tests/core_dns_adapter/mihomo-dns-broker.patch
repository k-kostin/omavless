--- /dev/null
+++ b/config/system_dns_test.go
@@ -0,0 +1,71 @@
+package config
+
+import (
+	"encoding/json"
+	"testing"
+
+	"go.yaml.in/yaml/v3"
+)
+
+func TestSystemDNSOption(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		input string
+		want  bool
+	}{
+		{"omitted", "{}", false},
+		{"false", "disable-system-dns: false", false},
+		{"true", "disable-system-dns: true", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var raw RawTun
+			if err := yaml.Unmarshal([]byte(tc.input), &raw); err != nil {
+				t.Fatal(err)
+			}
+			raw.DNSHijack = []string{"any:53"}
+			raw.AutoRoute = true
+			raw.FileDescriptor = 42
+			var general General
+			if err := parseTun(raw, &DNS{}, &general); err != nil {
+				t.Fatal(err)
+			}
+			if general.Tun.DisableSystemDNS != tc.want {
+				t.Fatal("DNS ownership flag lost")
+			}
+			if !general.Tun.AutoRoute || general.Tun.FileDescriptor != 42 ||
+				len(general.Tun.DNSHijack) != 1 || general.Tun.DNSHijack[0] != "any:53" {
+				t.Fatal("unrelated TUN configuration changed")
+			}
+			encoded, err := json.Marshal(general.Tun)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var fields map[string]any
+			if err := json.Unmarshal(encoded, &fields); err != nil {
+				t.Fatal(err)
+			}
+			if fields["disable-system-dns"] != tc.want {
+				t.Fatal("controller projection lost flag")
+			}
+		})
+	}
+}
+
+func TestSystemDNSBrokerReadyCannotBeConfigured(t *testing.T) {
+	for _, input := range []string{
+		"omavless-dns-broker: true\nomavless-dns-ready: true\ndisable-system-dns: true",
+		"omavless-dns-broker: true\nomavless-dns-ready: false\ndisable-system-dns: true",
+	} {
+		var raw RawTun
+		if err := yaml.Unmarshal([]byte(input), &raw); err != nil {
+			t.Fatal(err)
+		}
+		var general General
+		if err := parseTun(raw, &DNS{}, &general); err != nil {
+			t.Fatal(err)
+		}
+		if !general.Tun.OmaVLESSDNSBroker || !general.Tun.DisableSystemDNS || general.Tun.OmaVLESSDNSReady {
+			t.Fatal("configured readiness or lost broker ownership")
+		}
+	}
+}
