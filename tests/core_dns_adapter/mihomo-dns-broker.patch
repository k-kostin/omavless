+	"errors"
+	tun "github.com/metacubex/sing-tun"
+)
+
+func acquireSystemDNS(_ tun.Tun) (systemDNSLease, error) {
+	return nil, errors.New("OmaVLESS DNS broker is unavailable")
+}
