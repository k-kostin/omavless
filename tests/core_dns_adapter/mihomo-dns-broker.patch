@@ -0,0 +1,23 @@
+package config
+
+import "testing"
+
+func TestSystemDNSOwnershipChangeRequiresTunReplacement(t *testing.T) {
+	legacy := Tun{}
+	external := Tun{DisableSystemDNS: true}
+	if !legacy.Equal(legacy) || !external.Equal(external) {
+		t.Fatal("same policy must compare equal")
+	}
+	if legacy.Equal(external) || external.Equal(legacy) {
+		t.Fatal("changed DNS writer retained old TUN")
+	}
+	broker := Tun{DisableSystemDNS: true, OmaVLESSDNSBroker: true}
+	if external.Equal(broker) || broker.Equal(external) {
+		t.Fatal("broker enrollment change retained old TUN")
+	}
+	ready := broker
+	ready.OmaVLESSDNSReady = true
+	if !broker.Equal(ready) || !ready.Equal(broker) {
+		t.Fatal("volatile readiness must not force TUN replacement")
+	}
+}
