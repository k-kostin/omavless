 func (m *Manager) Join(c Tracker) {
+	m.connectionMu.Lock()
+	defer m.connectionMu.Unlock()
+	// Production tracker constructors enroll once, before publishing Info.
+	// Never reassign a token to an already enrolled object.
+	if c.Info().conditionalEnrolled {
+		return
+	}
+	c.Info().conditionalEnrolled = true
+	// Never wrap. Exhausted managers retain ordinary tracking, but no
+	// conditional-close capability for newly admitted connections.
+	c.Info().OmavlessCloseToken = ""
+	if m.closeSequence != math.MaxUint64 {
+		m.closeSequence++
+		c.Info().OmavlessCloseToken = strconv.FormatUint(m.closeSequence, 10)
+	}
 	m.connections.Store(c.ID(), c)
 }
 
 func (m *Manager) Leave(c Tracker) {
-	m.connections.Delete(c.ID())
+	m.connectionMu.Lock()
+	defer m.connectionMu.Unlock()
+	// A delayed Close on a removed tracker must not delete its successor.
+	if current := m.Get(c.ID()); current != nil && current.Info() == c.Info() {
+		m.connections.Delete(c.ID())
+	}
+}
+
+type ConditionalCloseResult uint8
+
+const (
+	ConditionalClosed ConditionalCloseResult = iota
+	ConditionalMissing
+	ConditionalMismatch
+	ConditionalUnavailable
+	ConditionalCloseFailed
+)
+
+// CloseIfToken removes only the exact observed incarnation under the same
+// publication lock, then closes that retained tracker outside the lock.
+// The token is meaningful only within this manager/core process lifetime.
+func (m *Manager) CloseIfToken(id, token string) ConditionalCloseResult {
+	m.connectionMu.Lock()
+	c := m.Get(id)
+	if c == nil {
+		m.connectionMu.Unlock()
+		return ConditionalMissing
+	}
+	if token == "" || c.Info().OmavlessCloseToken == "" {
+		m.connectionMu.Unlock()
+		return ConditionalUnavailable
+	}
+	if c.Info().OmavlessCloseToken != token {
+		m.connectionMu.Unlock()
+		return ConditionalMismatch
+	}
+	m.connections.Delete(id)
+	m.connectionMu.Unlock()
+	if c.Close() != nil {
+		return ConditionalCloseFailed
+	}
+	return ConditionalClosed
 }
 
