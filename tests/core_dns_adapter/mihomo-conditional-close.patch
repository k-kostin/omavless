+// This explicit, read-only ABI/readiness report is not inferred from version,
+// configured listeners, loaded rules, logs or a successful CONNECT response.
+func conditionalCloseCapabilities(w http.ResponseWriter, r *http.Request) {
+	if r.URL.RawQuery != "" || r.ContentLength != 0 {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	render.JSON(w, r, struct {
+		ABI   uint8 `json:"abi"`
+		Ready bool  `json:"ready"`
+	}{1, tunnel.Status() == tunnel.Running})
+}
+
+func closeConnectionConditional(w http.ResponseWriter, r *http.Request) {
+	// No JSON parser ambiguity, wildcard, query, body or legacy fallback.
+	values := r.Header.Values("If-Match")
+	if len(values) != 1 || r.ContentLength != 0 || r.URL.RawQuery != "" {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	value := values[0]
+	if len(value) < 2 || value[0] != '"' || value[len(value)-1] != '"' {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	token := value[1 : len(value)-1]
+	n, err := strconv.ParseUint(token, 10, 64)
+	if err != nil || n == 0 || strconv.FormatUint(n, 10) != token {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	if tunnel.Status() != tunnel.Running {
+		w.WriteHeader(http.StatusServiceUnavailable)
+		return
+	}
+	switch statistic.DefaultManager.CloseIfToken(chi.URLParam(r, "id"), token) {
+	case statistic.ConditionalClosed:
+		w.WriteHeader(http.StatusNoContent)
+	case statistic.ConditionalMissing:
+		w.WriteHeader(http.StatusNotFound)
+	case statistic.ConditionalMismatch:
+		w.WriteHeader(http.StatusConflict)
+	case statistic.ConditionalUnavailable:
+		w.WriteHeader(http.StatusServiceUnavailable)
+	default:
+		w.WriteHeader(http.StatusBadGateway)
+	}
+}
