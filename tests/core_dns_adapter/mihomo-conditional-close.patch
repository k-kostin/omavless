@@ -0,0 +1,126 @@
+package statistic
+
+import (
+	"errors"
+	"math"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type conditionalFixture struct {
+	C.Connection
+	id      string
+	info    *TrackerInfo
+	manager *Manager
+	closed  atomic.Int32
+	entered chan struct{}
+	release chan struct{}
+	fail    bool
+}
+
+func (c *conditionalFixture) ID() string         { return c.id }
+func (c *conditionalFixture) Info() *TrackerInfo { return c.info }
+func (c *conditionalFixture) Close() error {
+	c.closed.Add(1)
+	if c.entered != nil {
+		close(c.entered)
+		<-c.release
+	}
+	c.manager.Leave(c)
+	if c.fail {
+		return errors.New("synthetic close failure")
+	}
+	return nil
+}
+func fixture(m *Manager, id string) *conditionalFixture {
+	c := &conditionalFixture{id: id, info: &TrackerInfo{}, manager: m}
+	m.Join(c)
+	return c
+}
+
+func TestConditionalCloseReusedID(t *testing.T) {
+	m := &Manager{}
+	old := fixture(m, "same")
+	token := old.Info().OmavlessCloseToken
+	m.Leave(old)
+	next := fixture(m, "same")
+	if m.CloseIfToken("same", token) != ConditionalMismatch || next.closed.Load() != 0 {
+		t.Fatal("stale token closed successor")
+	}
+	if old.Info().OmavlessCloseToken == next.Info().OmavlessCloseToken {
+		t.Fatal("token reused")
+	}
+	if m.CloseIfToken("same", next.Info().OmavlessCloseToken) != ConditionalClosed {
+		t.Fatal("matching close refused")
+	}
+	if m.CloseIfToken("same", next.Info().OmavlessCloseToken) != ConditionalMissing {
+		t.Fatal("replay effects")
+	}
+}
+
+func TestConditionalCloseCannotReenroll(t *testing.T) {
+	m := &Manager{}
+	c := fixture(m, "same")
+	token := c.Info().OmavlessCloseToken
+	m.Leave(c)
+	m.Join(c)
+	if c.Info().OmavlessCloseToken != token || m.Get("same") != nil {
+		t.Fatal("already enrolled identity republished")
+	}
+}
+
+func TestConditionalCloseDelayedLeave(t *testing.T) {
+	m := &Manager{}
+	old := fixture(m, "same")
+	old.entered = make(chan struct{})
+	old.release = make(chan struct{})
+	done := make(chan ConditionalCloseResult, 1)
+	go func() { done <- m.CloseIfToken("same", old.Info().OmavlessCloseToken) }()
+	<-old.entered
+	next := fixture(m, "same")
+	close(old.release)
+	if <-done != ConditionalClosed || m.Get("same") != next || next.closed.Load() != 0 {
+		t.Fatal("delayed close damaged successor")
+	}
+}
+
+func TestConditionalCloseConcurrentConfirm(t *testing.T) {
+	m := &Manager{}
+	c := fixture(m, "only")
+	var wg sync.WaitGroup
+	for i := 0; i < 64; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); m.CloseIfToken(c.ID(), c.Info().OmavlessCloseToken) }()
+	}
+	wg.Wait()
+	if c.closed.Load() != 1 {
+		t.Fatal("more than one close")
+	}
+}
+
+func TestConditionalCloseExhaustionAndFailure(t *testing.T) {
+	m := &Manager{closeSequence: math.MaxUint64 - 1}
+	last := fixture(m, "last")
+	last.fail = true
+	if last.Info().OmavlessCloseToken != "18446744073709551615" {
+		t.Fatal("last token")
+	}
+	if m.CloseIfToken("last", last.Info().OmavlessCloseToken) != ConditionalCloseFailed {
+		t.Fatal("lost failure")
+	}
+	c := fixture(m, "exhausted")
+	if c.Info().OmavlessCloseToken != "" || m.CloseIfToken(c.ID(), "1") != ConditionalUnavailable || c.closed.Load() != 0 {
+		t.Fatal("wrap or absent wildcard")
+	}
+	if m.CloseIfToken(c.ID(), "") != ConditionalUnavailable {
+		t.Fatal("empty wildcard")
+	}
+	m.Leave(c)
+	m.Join(c)
+	if m.Get(c.ID()) != nil {
+		t.Fatal("exhausted tracker reenrolled")
+	}
+}
