+package route
+
+import (
+	"encoding/json"
+	"github.com/metacubex/mihomo/tunnel"
+	"strings"
+	"testing"
+
+	"github.com/metacubex/http"
+	"github.com/metacubex/http/httptest"
+)
+
+func TestConditionalCloseExplicitReadiness(t *testing.T) {
+	defer tunnel.OnRunning()
+	for _, ready := range []bool{false, true} {
+		if ready {
+			tunnel.OnRunning()
+		} else {
+			tunnel.OnInnerLoading()
+		}
+		w := httptest.NewRecorder()
+		connectionRouter().ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/conditional-capabilities", nil))
+		var got struct {
+			ABI   uint8 `json:"abi"`
+			Ready bool  `json:"ready"`
+		}
+		if w.Code != http.StatusOK || json.Unmarshal(w.Body.Bytes(), &got) != nil || got.ABI != 1 || got.Ready != ready {
+			t.Fatal("explicit conditional ABI/readiness mismatch")
+		}
+		if !ready {
+			r := httptest.NewRequest(http.MethodPost, "/missing/close-conditional", nil)
+			r.Header.Set("If-Match", `"1"`)
+			w := httptest.NewRecorder()
+			connectionRouter().ServeHTTP(w, r)
+			if w.Code != http.StatusServiceUnavailable {
+				t.Fatal("suspended core attempted close")
+			}
+		}
+	}
+}
+
+func TestConditionalCloseStrictRequest(t *testing.T) {
+	tunnel.OnRunning()
+	for _, value := range []string{"", "*", "1", `"0"`, `"01"`, `"+1"`, `"-1"`, `"18446744073709551616"`, `"1", "2"`} {
+		r := httptest.NewRequest(http.MethodPost, "/id/close-conditional", nil)
+		r.Header.Set("If-Match", value)
+		w := httptest.NewRecorder()
+		connectionRouter().ServeHTTP(w, r)
+		if w.Code != http.StatusBadRequest {
+			t.Fatalf("malformed token status %d", w.Code)
+		}
+	}
+	for _, variant := range []string{"duplicate", "query", "body"} {
+		url := "/id/close-conditional"
+		body := ""
+		if variant == "query" {
+			url += "?x=1"
+		}
+		if variant == "body" {
+			body = "x"
+		}
+		r := httptest.NewRequest(http.MethodPost, url, strings.NewReader(body))
+		r.Header.Set("If-Match", `"1"`)
+		if variant == "duplicate" {
+			r.Header.Add("If-Match", `"2"`)
+		}
+		w := httptest.NewRecorder()
+		connectionRouter().ServeHTTP(w, r)
+		if w.Code != http.StatusBadRequest {
+			t.Fatal("ambiguous request accepted")
+		}
+	}
+	r := httptest.NewRequest(http.MethodPost, "/missing/close-conditional", nil)
+	r.Header.Set("If-Match", `"1"`)
+	w := httptest.NewRecorder()
+	connectionRouter().ServeHTTP(w, r)
+	if w.Code != http.StatusNotFound {
+		t.Fatal("missing target not explicit")
+	}
+}
