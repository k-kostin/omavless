+#[cfg(test)]
+mod posix_return_tests {
+    use super::*;
+    use std::{cell::Cell, rc::Rc};
+    struct Owner(Rc<Cell<usize>>);
+    impl Drop for Owner { fn drop(&mut self) { self.0.set(self.0.get()+1); } }
+    #[test]
+    fn direct_error_numbers_not_errno_sentinels() {
+        assert!(posix_result(0).is_ok());
+        for code in [1, 2, 12, 22, 4095, -1, i32::MAX] {
+            assert_eq!(posix_result(code), Err(Errno::from_raw(code)));
+        }
+        // The old helper accepts a POSIX ENOMEM as success, independently of
+        // ambient errno. This control never calls an initializer or spawn.
+        assert!(Errno::result(libc::ENOMEM).is_ok());
+        assert_eq!(posix_result(libc::ENOMEM), Err(Errno::ENOMEM));
+    }
+    #[test]
+    fn failed_initializer_never_reads_uninitialized_output() {
+        for code in [libc::ENOMEM, libc::EINVAL, -1, i32::MAX] {
+            let storage=mem::MaybeUninit::<Owner>::uninit();
+            // SAFETY: nonzero code promises nothing about initialized storage.
+            assert!(unsafe { initialized(storage,code) }.is_err());
+        }
+    }
+    #[test]
+    fn successful_initializer_moves_one_original_owner() {
+        let count=Rc::new(Cell::new(0));
+        let storage=mem::MaybeUninit::new(Owner(count.clone()));
+        let owner=unsafe { initialized(storage,0) }.unwrap();
+        assert_eq!(count.get(),0);drop(owner);assert_eq!(count.get(),1);
+    }
+    #[test]
+    fn destroy_or_reinit_error_does_not_destroy_again() {
+        for failure in [0,1] {
+            let drops=Rc::new(Cell::new(0));let calls=Cell::new(0);
+            let result=unsafe { reinitialize(Owner(drops.clone()), |_| {
+                calls.set(calls.get()+1);posix_result(if failure==0 {libc::EINVAL}else{0})?;
+                calls.set(calls.get()+1);posix_result(libc::ENOMEM)
+            }) };
+            assert!(result.is_err());assert_eq!(calls.get(),failure+1);assert_eq!(drops.get(),0);
+        }
+    }
+    #[test]
+    fn reinit_unwind_retains_and_success_restores_normal_drop() {
+        let drops=Rc::new(Cell::new(0));
+        let result=std::panic::catch_unwind(std::panic::AssertUnwindSafe(||unsafe {
+            reinitialize(Owner(drops.clone()), |_| {panic!("inert producer cut")})
+        }));
+        assert!(result.is_err());assert_eq!(drops.get(),0);
+        let owner=unsafe {reinitialize(Owner(drops.clone()), |_|Ok(()))}.unwrap();
+        assert_eq!(drops.get(),0);drop(owner);assert_eq!(drops.get(),1);
+    }
