+// POSIX spawn routines return the error number itself, not -1 with errno.
+fn posix_result(code: libc::c_int) -> Result<()> {
+    if code == 0 { Ok(()) } else { Err(Errno::from_raw(code)) }
+}
+
+// SAFETY: The producer fully initializes storage whenever code is zero.
+// Nonzero outcomes must never read storage or construct its owner.
+unsafe fn initialized<T>(storage: mem::MaybeUninit<T>, code: libc::c_int) -> Result<T> {
+    posix_result(code)?;
+    Ok(unsafe { storage.assume_init() })
+}
+
+// SAFETY: operation restores a valid T before returning Ok. An error or unwind
+// can leave an already-destroyed/partly-initialized object; do not run Drop again.
+unsafe fn reinitialize<T>(value: T, operation: impl FnOnce(&mut T) -> Result<()>) -> Result<T> {
+    let mut retained = mem::ManuallyDrop::new(value);
+    operation(&mut retained)?;
+    Ok(mem::ManuallyDrop::into_inner(retained))
+}
